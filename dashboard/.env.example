# Control plane REST base URL
NEXT_PUBLIC_API_BASE=http://localhost:8080
# STOMP/SockJS endpoint (defaults to {API_BASE}/ws)
NEXT_PUBLIC_WS_URL=http://localhost:8080/ws
# Parent identity (replace with the value from your auth provider)
NEXT_PUBLIC_PARENT_ID=demo-parent
# Admin API key — DEVELOPMENT ONLY. In production, proxy policy mutations
# through an authenticated backend route instead of exposing a key.
NEXT_PUBLIC_ADMIN_KEY=change-me-in-production
